# Alchemy Infrastructure Environment Variables
# Copy to .env and fill in values for local development

# ===========================================
# Alchemy State Encryption
# ===========================================
ALCHEMY_PASSWORD=your-encryption-password-min-32-chars

# ===========================================
# Cloudflare Credentials
# ===========================================
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=

# ===========================================
# Production Only - Custom Domains
# ===========================================
# Only set these when deploying to production with custom domains
# WEB_DOMAIN=www.azertykeycaps.fr
# API_DOMAIN=api.azertykeycaps.fr

# Cloudflare Zone ID (for CDN cache purging)
# CLOUDFLARE_ZONE_ID=

# ===========================================
# App Environment Variables (bound to workers)
# ===========================================

# Payload CMS URL
# Dev: local CMS server
# Prod: Vercel deployment URL
CMS_API_URL=http://localhost:3000

# Authentication (Better-Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-auth-secret-change-in-production-min32

# Cache Invalidation (shared with CMS)
CACHE_INVALIDATION_SECRET=dev-cache-secret-min-32-characters-long

# CMS API Key for authenticated requests
# In dev: leave empty (CMS allows unauthenticated access)
# In prod: generate in CMS admin -> Users -> Create API user -> Enable API Key
CMS_API_KEY=
