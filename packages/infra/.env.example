# Alchemy Infrastructure Environment Variables
# Copy to .env and fill in values for local development

# ===========================================
# Alchemy State Encryption
# ===========================================
ALCHEMY_PASSWORD=your-encryption-password-min-32-chars

# ===========================================
# Cloudflare Credentials
# ===========================================
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_ID=

# ===========================================
# App Environment Variables (bound to workers)
# ===========================================

# CORS & URLs
CORS_ORIGIN=http://localhost:3001
VITE_SERVER_URL=http://localhost:3000
SERVER_URL=http://localhost:3000
CMS_API_URL=http://localhost:3002

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=your-auth-secret-min-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Cache Invalidation (shared with CMS)
CACHE_INVALIDATION_SECRET=your-cache-secret-min-32-chars-long
