  },
  "devDependencies": {
    "@azertykeycaps-app/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
