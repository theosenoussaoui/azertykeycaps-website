# Local development (file-based SQLite)
DATABASE_URL=file:./payload.db

# Production (Turso - set these in Vercel)
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Payload secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob (auto-set when you add Vercel Blob storage)
BLOB_READ_WRITE_TOKEN=

# Cache Invalidation
# Server API endpoint for invalidating CMS response cache
CACHE_INVALIDATION_URL=http://localhost:1337/api/cache/invalidate
CACHE_INVALIDATION_SECRET=your-shared-secret-min-32-chars

# Cloudflare CDN cache invalidation (for purging HTML pages)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
WEB_URL=http://localhost:3001
