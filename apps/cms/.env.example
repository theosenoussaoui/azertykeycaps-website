# ===========================================
# LOCAL DEVELOPMENT (Cloudflare Workers via Wrangler)
# ===========================================

# Payload secret (generate with: openssl rand -base64 32)
# In production, this is bound via Alchemy
PAYLOAD_SECRET=dev-secret-change-in-production-min-32-chars

# Cloudflare environment (optional, for multi-env setups)
# CLOUDFLARE_ENV=dev

# ===========================================
# BINDINGS (auto-configured by Alchemy/Wrangler)
# ===========================================
# These are set automatically when running locally via Wrangler
# or deployed via Alchemy. No manual configuration needed.
#
# D1 - Cloudflare D1 database binding
# R2 - Cloudflare R2 storage binding
# CACHE_INVALIDATION_URL - Server endpoint for cache invalidation
# CACHE_INVALIDATION_SECRET - Shared secret for cache invalidation
# WEB_URL - Frontend URL

# ===========================================
# NOTES
# ===========================================
# - Local dev uses Wrangler's getPlatformProxy for D1/R2 emulation
# - Production bindings are managed by Alchemy in packages/infra
# - Image processing is disabled (no sharp on Cloudflare Workers)
# - Media files are stored in Cloudflare R2
