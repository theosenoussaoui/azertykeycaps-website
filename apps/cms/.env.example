# ===========================================
# LOCAL DEVELOPMENT
# ===========================================

# SQLite database (file-based for local dev)
DATABASE_URL=file:./payload.db

# Payload secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=dev-secret-change-in-production-min-32-chars

# ===========================================
# PRODUCTION (Vercel/Turso)
# ===========================================

# Turso database (set in Vercel environment)
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Vercel Blob storage for media (auto-set when adding Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# ===========================================
# CACHE INVALIDATION
# ===========================================

# Server API endpoint for invalidating CMS response cache
# Dev: points to local Alchemy dev server
# Prod: points to Cloudflare Worker API
CACHE_INVALIDATION_URL=http://localhost:8787/api/cache/invalidate
CACHE_INVALIDATION_SECRET=dev-cache-secret-min-32-characters-long

# Cloudflare CDN cache invalidation (for purging HTML pages)
# Only needed in production
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# Public website URL (for CDN cache purging)
WEB_URL=http://localhost:3001
