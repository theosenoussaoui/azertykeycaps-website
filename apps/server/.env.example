# ===========================================
# AUTHENTICATION (Better-Auth)
# ===========================================

# Secret for signing auth tokens (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-auth-secret-change-in-production

# URL where the auth server is running
BETTER_AUTH_URL=http://localhost:8787

# ===========================================
# CORS
# ===========================================

# Allowed origin for CORS (web app URL)
CORS_ORIGIN=http://localhost:3001

# ===========================================
# CMS INTEGRATION
# ===========================================

# Payload CMS URL
CMS_API_URL=http://localhost:3000

# CMS API Key for authenticated requests to Payload CMS
# In dev: leave empty (CMS allows unauthenticated access)
# In prod: generate in CMS admin panel -> Users -> Create API user -> Enable API Key
CMS_API_KEY=

# ===========================================
# CACHE INVALIDATION
# ===========================================

# Shared secret with CMS for cache invalidation webhook
CACHE_INVALIDATION_SECRET=dev-cache-secret-min-32-characters-long