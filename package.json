{
  "name": "azertykeycaps-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/node": "^24.1.0",
      "@cloudflare/workers-types": "^4.20251228.0",
      "better-auth": "^1.4.9",
      "alchemy": "^0.82.1",
      "@libsql/client": "0.15.15",
      "libsql": "0.5.22",
      "@hono/zod-validator": "^0.6.3",
      "date-fns": "^4.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:cms": "turbo run build --filter=@azertykeycaps-app/cms",
    "build:no-cms": "turbo run build --filter=!@azertykeycaps-app/cms",
    "check": "oxlint && oxfmt --write",
    "check-types": "turbo run check-types",
    "check-types:cms": "turbo run check-types --filter=@azertykeycaps-app/cms",
    "check-types:no-cms": "turbo run check-types --filter=!@azertykeycaps-app/cms",
    "contentful:download": "cd .contentful && bun run download-images.ts",
    "contentful:rebuild-mapping": "bun run .contentful/rebuild-id-mapping.ts",
    "contentful:upload": "cd .contentful && bun run upload-images.ts",
    "db:generate": "turbo run db:generate --filter=@azertykeycaps-app/db",
    "db:push": "turbo run db:push --filter=@azertykeycaps-app/db",
    "deploy": "turbo run deploy --filter=@azertykeycaps-app/infra",
    "deploy:cms": "turbo run deploy --filter=@azertykeycaps-app/cms",
    "deploy:cms:app": "turbo run deploy:app --filter=@azertykeycaps-app/cms",
    "deploy:cms:database": "turbo run deploy:database --filter=@azertykeycaps-app/cms",
    "destroy": "turbo run destroy --filter=@azertykeycaps-app/infra",
    "dev": "turbo run dev",
    "dev:cms": "turbo run dev --filter=@azertykeycaps-app/cms",
    "dev:native": "turbo run dev --filter=native",
    "dev:no-cms": "turbo run dev --filter=!@azertykeycaps-app/cms",
    "dev:server": "turbo run dev --filter=server",
    "dev:web": "turbo run dev --filter=web",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only"
  },
  "dependencies": {
    "@azertykeycaps-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@azertykeycaps-app/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0",
    "turbo": "^2.7.6",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.7"
}
